PORT=

DB_HOST=

DB_PORT=5433

DB_USER=

DB_PASSWORD=

DB_NAME=

JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Correo de recuperación de contraseña. Sin SMTP_HOST los correos NO se envían
# (el enlace solo aparece en el log). Ejemplo con Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587 (STARTTLS) o 465 (TLS)
#   SMTP_USER=tu-cuenta@gmail.com
#   SMTP_PASSWORD=contraseña de aplicación de 16 letras (no la contraseña normal)
#   SMTP_FROM=tu-cuenta@gmail.com (si se deja vacío se usa SMTP_USER)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SELAVA
# Página del portal de clientes que recibe el token (en producción, la URL pública).
PASSWORD_RESET_URL=http://localhost:5174/restablecer-contrasena
